{
  "name": "dsh-web-workbench",
  "version": "0.1.1",
  "description": "Browser interaction, authenticated downloads, PDF text, OCR and video frames for DeepSeek Harness.",
  "repository": { "type": "git", "url": "git+https://github.com/CoraEJones/dsh-web-workbench.git" },
  "homepage": "https://github.com/CoraEJones/dsh-web-workbench#readme",
  "bugs": { "url": "https://github.com/CoraEJones/dsh-web-workbench/issues" },
  "keywords": ["deepseek-harness", "dsh-plugin", "cordis", "playwright", "browser-automation", "pdf", "ocr"],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13",
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "Install.cmd",
    "scripts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "install:dsh": "powershell.exe -NoProfile -File scripts/install-windows.ps1",
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --test test/*.test.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "pdfjs-dist": "^5.4.149",
    "playwright": "^1.55.0",
    "tesseract.js": "^6.0.1",
    "zod": "^4.1.0"
  }
}
